# Saved client chats are kept 90 days (2160 hours) so follow-ups and feedback can
# learn from them. Everything else from Upwork is deleted after 24 hours. Upwork's
# published rule is 24 hours for all of it, and nobody has asked them about
# this. To follow the rule to the letter, uncomment the line below.
# KEEP_CHAT_HOURS=24

# Used only by the optional /lead-magnet research run.
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional when Lighthouse is installed locally.
PAGESPEED_API_KEY=
# Two report chapters: whether AI search names the business, and what its worst
# reviews complain about. Without it both say so and the rest of the report is
# unaffected.
OPENAI_API_KEY=

# Required to publish client pitch pages. VERCEL_SCOPE is optional for a
# personal account. The project name is shared by this member's pitch pages.
# Leave VERCEL_TOKEN empty to use the account you logged into with 'vercel
# login'. A token always wins over that login, so check with 'vercel whoami
# --token <yours>' that it names the account you expect: a stale token
# publishes your client's page into somebody else's Vercel.
VERCEL_TOKEN=
VERCEL_SCOPE=
# setup.sh fills in a unique project name for this member.
VERCEL_PITCH_PROJECT=
# Optional override: an existing production alias ending in .vercel.app.
# VERCEL_PITCH_DOMAIN=

# The static map behind the 25-point Google Maps grid in the audit. Without it the
# grid is measured and the picture of it is missing, with no error anywhere.
GOOGLE_MAPS_API_KEY=

# Only when Chrome lives somewhere the scripts cannot find it by themselves.
CHROME_BIN=

# The illustrated sheet on the proposal page, drawn without leaving the terminal.
# Optional in the real sense: /sales-call-proposal --dry-run prints the prompt for any image
# model you already use, and the page embeds whatever lands in
# jobs/<id>/proposal-sketch.png. Without a drawing at all, the page is still complete.
KIE_AI_API_KEY=
